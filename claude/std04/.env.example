# 이 파일은 "이름표"일 뿐이다 — 실제 키를 여기에 적지 말 것. (이 파일만 git에 커밋된다)
#
# 실제 키는 저장소 밖에 둔다:
#   ~/.config/openrouter/env      (디렉터리 700, 파일 600)
#
# 처음 설정하거나 키를 교체할 때:
#   install -d -m 700 ~/.config/openrouter
#   (umask 077; printf 'OPENROUTER_API_KEY=sk-or-v1-...\n' > ~/.config/openrouter/env)
#   chmod 600 ~/.config/openrouter/env
#
# 한 번만 쓰고 말 때는 환경변수가 가장 안전하다(디스크에 남지 않는다):
#   OPENROUTER_API_KEY=sk-or-v1-... python3 your_script.py

OPENROUTER_API_KEY=
